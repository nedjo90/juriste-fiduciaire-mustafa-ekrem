{
  "mcpServers": {
    "cerebro": {
      "type": "stdio",
      "command": "python3",
      "args": [
        ".team/cerebro/mcp_server.py"
      ],
      "env": {}
    },
    "playwright": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@latest"
      ],
      "env": {}
    },
    "markitdown": {
      "type": "stdio",
      "command": "uvx",
      "args": [
        "markitdown-mcp"
      ],
      "env": {}
    }
  }
}
