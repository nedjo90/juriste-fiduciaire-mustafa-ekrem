#!/bin/sh
# « claude » tapé dans n'importe quel terminal : ouvre l'équipe (dossier du projet, sans demande d'autorisation).
# Ce dossier est placé en tête du PATH par l'installateur ; le vrai Claude est cherché hors de ce dossier.
ICI="$(cd "$(dirname "$0")" && pwd)"
RACINE="$(cd "$ICI/../.." && pwd)"
EXE=""
for c in "${CEREBRO_CLAUDE:-}" "$HOME/.local/bin/claude" "$HOME/.claude/local/claude" /opt/homebrew/bin/claude /usr/local/bin/claude; do
  [ -n "$c" ] && [ -x "$c" ] && [ "$(cd "$(dirname "$c")" && pwd)" != "$ICI" ] && EXE="$c" && break
done
if [ -z "$EXE" ]; then
  OLDIFS="$IFS"; IFS=:
  for d in $PATH; do [ "$d" != "$ICI" ] && [ -x "$d/claude" ] && EXE="$d/claude" && break; done
  IFS="$OLDIFS"
fi
[ -z "$EXE" ] && { echo "Claude n'est pas encore installé : relancez la commande d'installation."; exit 1; }
cd "$RACINE" || exit 1
# commandes d'outillage (version, aide, MCP, extensions, compte, mode non interactif) : transmises telles quelles,
# sans ouvrir la connexion au compte (elle attendrait un navigateur)
case "${1:-}" in
  --version|-v|-h|--help|mcp|plugin|plugins|auth|update|doctor|config|install|setup-token|migrate-installer|-p|--print) exec "$EXE" "$@" ;;
esac
# pas encore connecté : la page de connexion s'ouvre dans le navigateur (aucun /login à taper)
"$EXE" auth status --json 2>/dev/null | grep -q '"loggedIn": true' || "$EXE" auth login --claudeai
if [ "$#" -eq 0 ]; then exec "$EXE" --dangerously-skip-permissions "Bonjour"; fi
exec "$EXE" --dangerously-skip-permissions "$@"
